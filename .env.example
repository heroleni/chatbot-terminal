# =============================================================================
# Copy this file to .env and fill in your own credentials.
# .env is git-ignored: never commit real keys.
# =============================================================================

# --- Active provider ---------------------------------------------------------
# One of: openai | anthropic | gemini
# Can also be switched at runtime with the /provider command.
LLM_PROVIDER=openai

# --- OpenAI (required SDK) ---------------------------------------------------
# Service: https://api.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# --- Anthropic (required SDK) ------------------------------------------------
# Service: https://api.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Gemini (additional provider + RAG embeddings) ---------------------------
# Service: https://generativelanguage.googleapis.com
# Use a generally available model: preview models frequently return HTTP 503.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (deployed vector store: PostgreSQL + pgvector) -----------------
# Service URL from your Supabase project dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_key_here

# --- RAG tuning --------------------------------------------------------------
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

RAG_CHUNK_TOKENS=700      # target chunk size (challenge range: 500-800)
RAG_OVERLAP_TOKENS=100    # 100/700 = 14.3% overlap (challenge range: 10-20%)
RAG_TOP_K=5               # chunks retrieved per query
RAG_MIN_SCORE=0.35        # minimum cosine similarity; below this, nothing is returned
